{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Znect Forge Signed Module Catalog (schema v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "version", "issuedAtEpochSeconds", "expiresAtEpochSeconds", "modules", "signatureBase64"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "catalogId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*){1,5}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "issuedAtEpochSeconds": { "type": "integer", "minimum": 1 },
    "expiresAtEpochSeconds": { "type": "integer", "minimum": 1 },
    "signatureBase64": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "modules": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "version", "minForgeVersion", "maxForgeVersion", "minApi", "supportedAbis", "capabilities", "artifactSha256", "publisherId", "signingCertificateSha256", "license", "artifactSizeBytes", "artifactUrl", "releaseNotes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*){1,5}$", "maxLength": 160 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
          "version": { "$ref": "#/properties/version" },
          "minForgeVersion": { "$ref": "#/properties/version" },
          "maxForgeVersion": { "anyOf": [{ "$ref": "#/properties/version" }, { "type": "null" }] },
          "minApi": { "type": "integer", "minimum": 29, "maximum": 10000 },
          "supportedAbis": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["armeabi-v7a", "arm64-v8a", "x86", "x86_64"] } },
          "capabilities": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*){1,4}$", "maxLength": 96 } },
          "artifactSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "publisherId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "signingCertificateSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "license": { "type": "string", "minLength": 1, "maxLength": 128 },
          "artifactSizeBytes": { "type": "integer", "minimum": 1 },
          "artifactUrl": { "type": ["string", "null"], "format": "uri" },
          "releaseNotes": { "type": ["string", "null"], "maxLength": 2000 }
        }
      }
    }
  }
}
